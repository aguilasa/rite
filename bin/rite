#!/bin/sh
# Rite CLI launcher: sh "${CLAUDE_PLUGIN_ROOT}/bin/rite" <subcommand> [args]
#
# Commands find this script by ${CLAUDE_PLUGIN_ROOT}, then $RITE_HOME, then `rite` on PATH — never by
# searching the disk, which cost whole turns before it was written down.
here=$(dirname "$0")
exec sh "$here/pyrun" "$here/rite.py" "$@"
